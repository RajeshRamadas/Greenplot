# Copy to .env and fill in. Never commit the real .env.
POSTGRES_PASSWORD=change-me

GP_ENVIRONMENT=production
# Long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
GP_SECRET_KEY=change-me
# Public URL of the web app (used for signed media URLs and invite links)
GP_PUBLIC_BASE_URL=https://app.example.com
GP_CORS_ORIGINS=https://app.example.com

# Media storage: "local" (Docker volume) or "s3" for S3 / Cloudflare R2
GP_STORAGE_BACKEND=local
# GP_S3_BUCKET=greenplot-media
# GP_S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# GP_S3_ACCESS_KEY=
# GP_S3_SECRET_KEY=
GP_ROUTINE_MEDIA_RETENTION_DAYS=90

# Payment gateway webhook secret (Razorpay-compatible HMAC signature)
GP_PAYMENT_WEBHOOK_SECRET=change-me

# WhatsApp Business Cloud API (Meta). Leave as "log" to only log messages.
GP_WHATSAPP_PROVIDER=log
# GP_WHATSAPP_PHONE_NUMBER_ID=
# GP_WHATSAPP_ACCESS_TOKEN=          # permanent System User token with whatsapp_business_messaging
# GP_WHATSAPP_APP_SECRET=            # verifies webhook signatures (required when provider=meta)
# GP_WHATSAPP_VERIFY_TOKEN=          # any random string; enter the same value in Meta's webhook setup
# GP_WHATSAPP_TEMPLATE=greenplot_update
# GP_WHATSAPP_TEMPLATE_LANGUAGE=en
# GP_WHATSAPP_NUMBER=918105568225    # business number shown on the website and profile

# Email (SMTP) for invites, password-reset codes and security alerts. Without a host, emails are only logged.
# GP_SMTP_HOST=smtp.example.com
# GP_SMTP_PORT=587
# GP_SMTP_USER=
# GP_SMTP_PASSWORD=
# GP_SMTP_FROM=GreenPlot <no-reply@example.com>
# WhatsApp Authentication template for one-time codes (body {{1}} = code, with a copy-code button)
# GP_WHATSAPP_OTP_TEMPLATE=greenplot_otp

# Account protection
# Roles that must use 2-step verification (authenticator app)
GP_MFA_REQUIRED_ROLES=super_admin,layout_admin
# GP_LOCKOUT_THRESHOLD=5
# GP_LOCKOUT_MINUTES=15
# GP_OTP_MINUTES=10
